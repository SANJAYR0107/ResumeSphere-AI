# ResumeSphere AI — Environment Configuration Template
# Copy to .env for local overrides

# Application Environment (production, staging, development)
APP_ENV=production

# Server Port
PORT=8000

# Debug Mode (set to true for development only)
DEBUG=false

# Allowed CORS Origins (comma-separated domains or * for public API)
ALLOWED_ORIGINS=*

# Max Resume Upload Size in Bytes (Default: 10MB = 10485760)
MAX_UPLOAD_BYTES=10485760

# HuggingFace Embedding Model Identity
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
